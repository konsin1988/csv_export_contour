# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY script.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/script .

FROM alpine:3.20

WORKDIR /app

COPY --from=build /out/script /usr/local/bin/script

CMD ["script"]
